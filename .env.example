# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Convex (from `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=

# Also set on the Convex deployment:
# CLERK_JWT_ISSUER_DOMAIN=https://YOUR_INSTANCE.clerk.accounts.dev
#
# Grant dashboard access in Convex Data → users → set role to manager|admin
# (not via Clerk publicMetadata).
